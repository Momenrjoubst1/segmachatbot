{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "rules": {
    "@typescript-eslint/no-unused-vars": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "no-console": "off",
    "no-unused-vars": "off"
  },
  "ignore": [
    "node_modules/",
    "dist/",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}