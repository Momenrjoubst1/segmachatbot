# Sigma AI Backend Environment Variables

# ──── Supabase ────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=chat_media

# ──── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Set to "redis" to enable Redis-backed rate limiting and guest quotas
# (required for multi-instance deployments). Leave unset for in-memory fallback.
RATE_LIMIT_STORE=redis

# ──── AI Providers (at least one required) ────────────────────
# Google Gemini (Free Tier - aistudio.google.com)
# Models: gemini-2.5-flash (10 RPM), gemini-2.5-pro (5 RPM), gemini-3-flash, gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_API_KEY=your_google_api_key
AZURE_API_KEY=your_azure_api_key
# Groq (Free Tier - 30 RPM, ultra-fast LPU inference)
# Models: llama-3.3-70b, llama-3.1-8b, gpt-oss-120b, gpt-oss-20b, qwen3-32b, mixtral-8x7b
GROQ_API_KEY=your_groq_api_key
GITHUB_TOKEN=your_github_token
OPENROUTER_API_KEY=your_openrouter_api_key
FIREWORKS_API_KEY=your_fireworks_api_key
NOVITA_API_KEY=your_novita_api_key
BAICHAT_API_KEY=your_baichat_api_key
# NVIDIA NIM (Free Tier - build.nvidia.com)
# Models: Nemotron 70B, Llama 3.3 70B, DeepSeek R1, Qwen 2.5 72B
NVIDIA_API_KEY=your_nvidia_api_key
# Cerebras (Free Tier - 1M tokens/day, no credit card)
# Models: Llama 3.3 70B, Llama 3.1 8B
CEREBRAS_API_KEY=your_cerebras_api_key

# ──── Default Model ───────────────────────────────────────────
ASSISTANT_DEFAULT_MODEL=deepseek-v4-flash

# ──── Server ──────────────────────────────────────────────────
PORT=3004
NODE_ENV=development

# ──── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ──── Guest Mode Cookies ──────────────────────────────────────
# Cookie SameSite attribute for guest sessions
# - "Lax" (default): Same-site or subdomain deployments
# - "None": True cross-origin (requires HTTPS in production)
# - "Strict": Strictest same-site only
GUEST_COOKIE_SAMESITE=Lax

# ──── Email (Optional) ────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ──── Web Search (Optional) ──────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key

# ──── Translation (Optional) ─────────────────────────────────
AZURE_TRANSLATOR_KEY=your_translator_key
AZURE_TRANSLATOR_REGION=your_region

# ──── Multi-Agent (Optional) ─────────────────────────────────
MULTI_AGENT_ENABLED=false

# ──── Memory Config ──────────────────────────────────────────
MEMORY_MAX_MESSAGES=50
MEMORY_KEEP_FIRST=3
MEMORY_KEEP_LAST=10
MEMORY_SUMMARY_MAX_TOKENS=500
MAX_CONTEXT_TOKENS=128000

# ──── RAG / BM25 Search ───────────────────────────────────────
BM25_STOP_WORDS=["و","في","من","إلى","عن","على","كان","مع"]

# ──── Cloudflare R2 (Textbook Images) ─────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=textbook-images
R2_PUBLIC_URL=https://pub-your-account-id.r2.dev

# ──── Prompt / A/B Testing ───────────────────────────────────
# Enable persona A/B testing (default false — uses 'default' for all users)
PROMPT_AB_ENABLED=false
# Variant: auto (hash by userId) or fixed: default | concise | detailed | motivational
PROMPT_AB_VARIANT=auto
# Force a variant for all users (overrides AB_VARIANT, for QA)
# PROMPT_AB_FORCE_VARIANT=concise
# Max system prompt tokens (0 = unlimited). Approx 1 token ≈ 4 chars.
# PROMPT_MAX_TOKENS=3000
# Log prompt metrics (variant, length, tokens) on every request
PROMPT_METRICS_ENABLED=true

# ──── Textbook Pipeline ───────────────────────────────────────
TEXTBOOK_MATCH_THRESHOLD=0.4
# Stronger model for textbook-based QA (when textbook chunks are present)
# Falls back to the user-selected model if not set or provider unavailable.
TEXTBOOK_QA_MODEL=gemini-2.5-pro

# Vision: model used when a message contains images and the selected model lacks native vision.
# Falls back to the user-selected model when unset. Also accepts images natively when the
# selected model matches known vision families or VISION_NATIVE_MODELS (comma-separated).
VISION_MODEL=gemini-2.5-flash
# VISION_NATIVE_MODELS=gpt-4o,gemini-2.5-pro,claude-4-sonnet

# AI image generation (Gemini native image-out). Free tier has a low daily quota.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_GEN_DAILY_LIMIT=15

# Deepgram Nova-3 -- voice dictation (mic button). Free 200 USD credit at signup.
DEEPGRAM_API_KEY=
STT_DAILY_MINUTES_LIMIT=30
STT_MAX_SESSION_SECONDS=120