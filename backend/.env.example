# Sigma AI Backend Environment Variables

# ──── Supabase ────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=chat_media

# ──── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Set to "redis" to enable Redis-backed rate limiting and guest quotas
# (required for multi-instance deployments). Leave unset for in-memory fallback.
RATE_LIMIT_STORE=redis

# ──── AI Providers (at least one required) ────────────────────
GOOGLE_API_KEY=your_google_api_key
AZURE_API_KEY=your_azure_api_key
GROQ_API_KEY=your_groq_api_key
GITHUB_TOKEN=your_github_token
OPENROUTER_API_KEY=your_openrouter_api_key
FIREWORKS_API_KEY=your_fireworks_api_key
NOVITA_API_KEY=your_novita_api_key

# ──── Default Model ───────────────────────────────────────────
ASSISTANT_DEFAULT_MODEL=gpt-5.4

# ──── Server ──────────────────────────────────────────────────
PORT=3004
NODE_ENV=development

# ──── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ──── Guest Mode Cookies ──────────────────────────────────────
# Cookie SameSite attribute for guest sessions
# - "Lax" (default): Same-site or subdomain deployments
# - "None": True cross-origin (requires HTTPS in production)
# - "Strict": Strictest same-site only
GUEST_COOKIE_SAMESITE=Lax

# ──── Email (Optional) ────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ──── Web Search (Optional) ──────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key

# ──── Translation (Optional) ─────────────────────────────────
AZURE_TRANSLATOR_KEY=your_translator_key
AZURE_TRANSLATOR_REGION=your_region

# ──── Multi-Agent (Optional) ─────────────────────────────────
MULTI_AGENT_ENABLED=false

# ──── Memory Config ──────────────────────────────────────────
MEMORY_MAX_MESSAGES=50
MEMORY_KEEP_FIRST=3
MEMORY_KEEP_LAST=10
MEMORY_SUMMARY_MAX_TOKENS=500
MAX_CONTEXT_TOKENS=128000

# ──── RAG / BM25 Search ───────────────────────────────────────
BM25_STOP_WORDS=["و","في","من","إلى","عن","على","كان","مع"]

# ──── Cloudflare R2 (Textbook Images) ─────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=textbook-images
R2_PUBLIC_URL=https://pub-your-account-id.r2.dev

# ──── Textbook Pipeline ───────────────────────────────────────
TEXTBOOK_MATCH_THRESHOLD=0.4
